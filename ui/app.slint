import { ScrollView, LineEdit, Button, CheckBox, ComboBox } from "std-widgets.slint";

export struct DeviceRow {
    id: string,
    title: string,
    hardware-name: string,
    serial: string,
    usb-id: string,
    kind: string,
    percentage: string,
    level: float,
    fresh: bool,
    present: bool,
    status: string,
    updated: string,
    alias: string,
    identity-note: string,
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: touch.has-hover ? #e4ece8 : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    Image { width: 18px; height: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: root.icon; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component DeviceCard inherits Rectangle {
    in property <DeviceRow> data;
    private property <bool> show-hardware-name: root.data.alias != "" && root.data.alias != root.data.hardware-name;
    callback edit();
    callback copy-serial();
    height: 208px;
    border-radius: 18px;
    border-width: 1px;
    border-color: data.present ? #e4ece8 : #e8edeb;
    background: #ffffff;

    Rectangle {
        x: 16px; y: 17px; width: 43px; height: 43px;
        border-radius: 12px; background: root.data.present ? #eff5f2 : #f4f5f5;
        Image { x: 8px; y: 8px; width: 27px; height: 27px; source: root.data.kind == "mouse" ? @image-url("../assets/mouse.svg") : @image-url("../assets/headset.svg"); opacity: root.data.present ? 1 : 0.45; }
    }
    Text { x: 71px; y: 17px; width: parent.width - 120px; height: 25px; text: root.data.title; font-size: 17px; font-weight: 600; color: #19392d; overflow: elide; }
    Text { x: 71px; y: 43px; width: parent.width - 100px; height: 18px; text: root.data.kind == "mouse" ? "无线鼠标 · 2.4G" : "无线耳机 · 2.4G"; font-size: 11px; color: #71857a; overflow: elide; }
    Rectangle {
        x: parent.width - 40px; y: 14px; width: 26px; height: 26px; border-radius: 7px;
        background: edit-touch.has-hover ? #edf5f0 : transparent;
        Image { x: 5px; y: 5px; width: 16px; height: 16px; source: @image-url("../assets/edit.svg"); }
        edit-touch := TouchArea { mouse-cursor: pointer; clicked => { root.edit(); } }
        accessible-role: button; accessible-label: "编辑备注"; accessible-action-default => { root.edit(); }
    }

    Text { x: 18px; y: 75px; width: 140px; height: 45px; text: root.data.percentage; font-size: 35px; font-weight: 500; color: root.data.fresh ? #19392d : #8f9e96; }
    Text { x: parent.width - 146px; y: 93px; width: 128px; height: 18px; text: root.data.status; horizontal-alignment: right; font-size: 11px; color: root.data.fresh ? #00896c : #829088; overflow: elide; }
    Rectangle {
        x: 18px; y: 125px; width: parent.width - 36px; height: 5px; border-radius: 3px; background: #e9efec;
        Rectangle { x: 0px; y: 0px; width: parent.width * root.data.level; height: parent.height; border-radius: 3px; background: !root.data.fresh ? #bac8bf : root.data.level < 0.3 ? #cd6854 : root.data.level < 0.6 ? #c19a43 : #00896c; }
    }
    if root.show-hardware-name: Text { x: 18px; y: 140px; width: parent.width - 36px; height: 17px; text: root.data.hardware-name; color: #62776b; font-size: 11px; overflow: elide; }
    Text { x: 18px; y: root.show-hardware-name ? 162px : 143px; width: parent.width - 36px; height: 17px; text: root.data.serial; color: #7b8c82; font-size: 10px; overflow: elide; }
    TouchArea { x: 16px; y: root.show-hardware-name ? 159px : 140px; width: parent.width - 32px; height: 23px; mouse-cursor: pointer; clicked => { root.copy-serial(); } }
    Text { x: 18px; y: root.show-hardware-name ? 185px : 171px; width: parent.width - 36px; height: 14px; text: root.data.updated; color: #89988f; font-size: 10px; overflow: elide; }
}

export component AppWindow inherits Window {
    title: "Periph In One";
    preferred-width: 360px;
    preferred-height: 640px;
    min-width: 320px;
    min-height: 340px;
    background: #f3f6f5;
    no-frame: true;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    icon: @image-url("../assets/brand.svg");

    in property <[DeviceRow]> devices;
    in property <string> summary: "等待设备";
    in property <string> updated: "尚未刷新";
    in property <string> notice;
    in property <bool> busy;
    in-out property <bool> settings-open;
    in-out property <bool> autostart;
    in-out property <bool> editing;
    in-out property <string> editing-id;
    in-out property <string> editing-name;
    in-out property <string> editing-alias;
    in-out property <string> editing-serial;
    in-out property <string> editing-identity;
    in property <[string]> rebind-options;
    private property <int> columns: root.width > root.height ? max(1, floor((root.width - 30px) / 280px)) : 1;
    callback refresh();
    callback hide-window();
    callback drag-window();
    callback edit-device(string);
    callback save-remark(string, string);
    callback rebind-remark(string, int);
    callback copy-serial(string);
    callback toggle-autostart(bool);

    Rectangle { border-width: 1px; border-color: #dce5df; border-radius: 16px; background: transparent; }
    TouchArea {
        height: 84px;
        pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag-window(); } }
    }
    Image { x: 22px; y: 25px; width: 38px; height: 38px; source: @image-url("../assets/brand.svg"); }
    Text { x: 72px; y: 21px; width: parent.width - 174px; height: 31px; text: "Periph In One"; font-size: 20px; font-weight: 700; color: #19392d; }
    Text { x: 73px; y: 54px; width: parent.width - 96px; height: 18px; text: root.summary; font-size: 11px; color: #6c8274; overflow: elide; }
    IconButton { x: parent.width - 92px; y: 28px; icon: @image-url("../assets/settings.svg"); label: "设置"; clicked => { root.settings-open = !root.settings-open; } }
    IconButton { x: parent.width - 52px; y: 28px; icon: @image-url("../assets/close.svg"); label: "隐藏到托盘"; clicked => { root.hide-window(); } }

    ScrollView {
        x: 18px; y: 90px; width: parent.width - 36px; height: parent.height - 150px;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, ceil(root.devices.length / root.columns) * 220px);
        for data[index] in root.devices: DeviceCard {
            width: (parent.width - (root.columns - 1) * 12px) / root.columns;
            x: mod(index, root.columns) * (self.width + 12px);
            y: floor(index / root.columns) * 220px;
            data: data;
            edit => { root.edit-device(data.id); }
            copy-serial => { root.copy-serial(data.id); }
        }
        if root.devices.length == 0: Rectangle {
            width: parent.width; height: 220px;
            border-radius: 18px; border-width: 1px; border-color: #e2eae5; background: #ffffff;
            Image { x: (parent.width - 48px) / 2; y: 40px; width: 48px; height: 48px; source: @image-url("../assets/brand.svg"); }
            Text { x: 16px; y: 106px; width: parent.width - 32px; height: 24px; text: root.busy ? "正在寻找设备…" : "还没有发现设备"; horizontal-alignment: center; font-size: 16px; font-weight: 600; color: #375546; }
            Text { x: 20px; y: 143px; width: parent.width - 40px; height: 45px; text: "请连接设备接收器"; horizontal-alignment: center; wrap: word-wrap; font-size: 11px; color: #829387; }
        }
    }

    Text { x: 24px; y: parent.height - 46px; width: parent.width - 84px; height: 18px; text: root.busy ? "正在读取设备…" : root.updated; font-size: 11px; color: #6e8275; overflow: elide; }
    if root.notice != "": Text { x: 24px; y: parent.height - 25px; width: parent.width - 48px; height: 18px; text: root.notice; font-size: 10px; color: #a36e3d; overflow: elide; }
    IconButton { x: parent.width - 54px; y: parent.height - 54px; icon: @image-url("../assets/refresh.svg"); label: "立即刷新"; clicked => { if !root.busy { root.refresh(); } } }

    if root.settings-open || root.editing: Rectangle {
        background: #18382b44;
        TouchArea { clicked => { root.settings-open = false; root.editing = false; } }
    }

    if root.settings-open: Rectangle {
        x: max(16px, (parent.width - 360px) / 2); y: max(24px, (parent.height - self.height) / 2);
        width: min(parent.width - 32px, 360px); height: 142px;
        border-radius: 18px; background: #ffffff;
        TouchArea { clicked => {} }
        ScrollView {
        viewport-width: self.visible-width;
        VerticalLayout {
            padding: 22px; spacing: 12px;
            HorizontalLayout { Text { text: "设置"; font-size: 20px; font-weight: 600; color: #19392d; } IconButton { icon: @image-url("../assets/close.svg"); label: "关闭设置"; clicked => { root.settings-open = false; } } }
            CheckBox { text: "开机启动"; checked <=> root.autostart; toggled => { root.toggle-autostart(self.checked); } }
        }
        }
    }

    if root.editing: Rectangle {
        x: max(16px, (parent.width - 390px) / 2); y: max(18px, (parent.height - self.height) / 2);
        width: min(parent.width - 32px, 390px); height: min(parent.height - 36px, 420px);
        border-radius: 18px; background: #ffffff;
        TouchArea { clicked => {} }
        ScrollView {
            viewport-width: self.visible-width;
            VerticalLayout {
                padding: 22px; spacing: 12px;
                HorizontalLayout { Text { text: "设备备注"; font-size: 20px; font-weight: 600; color: #19392d; } IconButton { icon: @image-url("../assets/close.svg"); label: "取消编辑"; clicked => { root.editing = false; } } }
                Text { text: root.editing-name; color: #62796a; font-size: 12px; wrap: word-wrap; }
                Text { text: root.editing-serial; color: #71877a; font-size: 11px; wrap: char-wrap; }
                if root.editing-identity != "": Text { text: root.editing-identity; color: #a36e3d; font-size: 10px; wrap: word-wrap; }
                LineEdit { text <=> root.editing-alias; placeholder-text: "例如：办公鼠标"; accepted => { root.save-remark(root.editing-id, root.editing-alias); } }
                Button { text: "保存"; primary: true; clicked => { root.save-remark(root.editing-id, root.editing-alias); } }
                if root.notice != "": Text { text: root.notice; color: #a36e3d; font-size: 10px; wrap: word-wrap; }
                if root.rebind-options.length > 0: VerticalLayout {
                    spacing: 8px;
                    Text { text: "离线记录"; font-size: 11px; color: #71877a; }
                    source-record := ComboBox { model: root.rebind-options; }
                    Button { text: "恢复备注"; clicked => { root.rebind-remark(root.editing-id, source-record.current-index); } }
                }
            }
        }
    }
}
